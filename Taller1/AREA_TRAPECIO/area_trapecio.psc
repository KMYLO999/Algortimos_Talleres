Algoritmo area_trapecio
	Definir area, basemenor, basemayor, altura, suma, division, multiplicacion Como Real
	Escribir 'Vamos a calcular el área de un trapecio'
	Escribir 'Digite la base menor en números'
	Leer basemenor
	Escribir 'Digite la base mayor en números'
	Leer basemayor
	Escribir 'Digite la altura en números'
	Leer altura
	area <- ((basemenor+basemayor)/2*altura)
	Escribir 'El área de un trapecio es: ', area
FinAlgoritmo
Algoritmo sumar_valores
	Definir valor1, valor2, valor3, suma Como Real
	Escribir 'Vamos a sumar 3 valores'
	Escribir 'Por favor digite el valor1 en números'
	Leer valor1
	Escribir 'Por favor digite el valor2 en números'
	Leer valor2
	Escribir 'Por favor digite el valor3 en números'
	Leer valor3
	suma <- (valor1+valor2+valor3)
	Escribir 'La suma es: ', suma
FinAlgoritmo

Algoritmo area_rombo
	Definir area, diagonalmenor, diagonalmayor Como Real
	Escribir 'Vamos a calcular el área de un rombo'
	Escribir 'Digite la Diagonal Menor en números'
	Leer diagonalmenor
	Escribir 'Digite la Diagonal Mayor en números'
	Leer diagonalmayor
	area <- (diagonalmenor*diagonalmayor)/2
	Escribir 'El área de un rombo es: ', area
FinAlgoritmo

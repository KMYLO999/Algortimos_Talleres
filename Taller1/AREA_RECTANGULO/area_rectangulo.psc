Algoritmo area_rectangulo
	Definir area, base, altura Como Real
	Escribir 'Vamos a calcular el área de un rectangulo'
	Escribir 'Digite la base en números'
	Leer base
	Escribir 'Digite la altura en números'
	Leer altura
	area <- (base*altura)
	Escribir 'El área de un rectángulo es: ', area
FinAlgoritmo

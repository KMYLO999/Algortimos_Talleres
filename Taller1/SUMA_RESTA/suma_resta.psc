Algoritmo suma_resta
	Definir suma, valor1, valor2, valor3, valor4, resta Como Real
	Escribir 'Vamos a sumar todos los valores y después restar el último valor'
	Escribir 'Digite el valor1 en números'
	Leer valor1
	Escribir 'Digite el valor2 en números'
	Leer valor2
	Escribir 'Digite el valor3 en números'
	Leer valor3
	Escribir 'Digite el valor4 en números'
	Leer valor4
	suma <- (valor1+valor2+valor3+valor4)
	Escribir 'La suma es: ', suma
	resta <- (suma-valor4)
	Escribir 'La resta es: ', resta
FinAlgoritmo
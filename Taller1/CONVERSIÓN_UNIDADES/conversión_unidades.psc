Algoritmo conversion
	Definir division, multiplicacion, mts, kms, hm, dam, dm, cm, mm Como Real
	Escribir 'Vamos a leer un valor en metros y convertirlo a cada unidad de conversión'
	Escribir 'Digite los metros en números'
	Leer mts
	kms <- mts/1000
	Escribir 'La conversión  de Kilometros es: ', kms
	hm <- mts/100
	Escribir 'La conversión  de Hectometros es: ', hm
	dam <- mts/10
	Escribir 'La conversión  de Decametros es: ', dam
	dm <- mts*10
	Escribir 'La conversión  de Decimetros es: ', dm
	cm <- mts*100
	Escribir 'La conversión  de Centpimetros es: ', cm
	mm <- mts*1000
	Escribir 'La conversión  de Milímetros es: ', mm
FinAlgoritmo

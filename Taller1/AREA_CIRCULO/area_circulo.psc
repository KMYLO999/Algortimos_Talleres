Algoritmo area_circulo
	Definir area, numeropi, radio, multiplicacion Como Real
	Escribir 'Vamos a calcular el área de un círculo'
	Escribir 'Digite el numero de pi'
	Leer numeropi
	Escribir 'Digite el radio en números'
	Leer radio
	area <- (numeropi*radio^2)
	Escribir 'El área del círculo es: ', area
FinAlgoritmo
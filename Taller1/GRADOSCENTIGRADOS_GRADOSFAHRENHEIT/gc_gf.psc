Algoritmo gc_gf
	Definir gradosfahrenheit, gradoscentigrados Como Real
	Escribir 'Vamos a convertir grados centigrados a grados fahrenheit'
	Escribir 'Digite en números los grados centigrados'
	Leer gradoscentigrados
	gradosfahrenheit <- (gradoscentigrados*9/5)+32
	Escribir 'Los grados Fahrenheit son: ', gradosfahrenheit
FinAlgoritmo
